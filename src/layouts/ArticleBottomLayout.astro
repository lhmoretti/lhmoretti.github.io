---
import { type CollectionEntry, getCollection } from "astro:content"
import { useTranslations } from "@i18n/ui"

type Props = {
  lang?: "es" | "en";
  entry: CollectionEntry<"certifications"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry, lang = "es" } = Astro.props as any
const { collection } = entry
const { Content } = await entry.render()
const t = useTranslations(lang)

// Get the next and prev entries (modulo to wrap index)
const items = ((await getCollection(collection as any)) as any[])
  .filter((post: any) => !post.data.draft && post.slug.split("/")[0] === lang)
  .sort((a: any, b: any) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex((x: any) => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <article>
    <Content/>
  </article>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href={lang === "en" ? `/en/${prev.collection}/${prev.slug.split("/").slice(1).join("/")}` : `/${prev.collection}/${prev.slug.split("/").slice(1).join("/")}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-term-panel border-term-border blend">
      <div class="order-2 w-full h-full group-hover:text-term-fg blend">
        <div class="flex flex-wrap gap-2">
          <div class="text-sm uppercase">
            {t("article.prev")}
          </div>
        </div>
        <div class="font-semibold mt-3 text-term-fg">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-term-fg rotate-180">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
    <a href={lang === "en" ? `/en/${next.collection}/${next.slug.split("/").slice(1).join("/")}` : `/${next.collection}/${next.slug.split("/").slice(1).join("/")}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-term-panel border-term-border transition-colors duration-300 ease-in-out">
      <div class="w-full h-full text-right group-hover:text-term-fg blend">
        <div class="text-sm uppercase">
          {t("article.next")}
        </div>
        <div class="font-semibold mt-3 text-term-fg">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-term-fg">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
  </div>
</div>
