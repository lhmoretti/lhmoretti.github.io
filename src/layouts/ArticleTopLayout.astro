---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"
import { useTranslations } from "@i18n/ui"

type Props = {
  lang?: "es" | "en";
  entry: CollectionEntry<"projects"> | CollectionEntry<"certifications">
}

const { entry, lang = "es" } = Astro.props as any
const t = useTranslations(lang)
const { collection, data, body } = entry
const { title, summary, date } = data

const repoUrl = collection === "projects" ? data.repoUrl : null
const category = collection === "projects" ? (data as any).category : null
---

<div>
  <a href={lang === "en" ? `/en/${collection}` : `/${collection}`} class="group w-fit p-1.5 gap-1.5 text-sm flex items-center border rounded hover:bg-term-panel border-term-border transition-colors duration-300 ease-in-out">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-term-fg">
      <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
      <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
    </svg>
    <div class="w-full group-hover:text-term-fg transition-colors duration-300 ease-in-out">
      {lang === "es" ? "Volver a" : "Back to"} {collection}
    </div>
  </a>
  <div class="flex flex-wrap text-sm uppercase mt-12 gap-3 opacity-75">
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#calendar"/>
      </svg>
      {formatDate(date, lang)}
    </div>
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#book-open"/>
      </svg>
      {readingTime(body, lang)}
    </div>
    {category && 
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full bg-term-panel text-xs font-medium normal-case">
          {category}
        </span>
      </div>
    }
  </div>
  <h1 class="text-3xl font-semibold text-term-fg mt-2">
    {title}
  </h1>
  <div class="mt-1">
    {summary}
  </div>
  {repoUrl && 
  <div class="mt-4 flex flex-wrap gap-2">
    {repoUrl && 
      <a href={repoUrl} target="_blank" class="group flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-term-border hover:bg-term-panel blend">
        <svg class="size-4">
          <use href="/ui.svg#link" class="fill-current group-hover:fill-term-fg blend"/>
        </svg>
        <span class="text-current group-hover:text-term-fg blend">
          {t("article.repo")}
        </span>
      </a>
    }
  </div> 
  }
</div>

<script>
  import { trackEvent } from "@lib/analytics";
  trackEvent("article_view", {
    collection: window.location.pathname.split("/").filter(Boolean)[0] === "en"
      ? window.location.pathname.split("/").filter(Boolean)[1]
      : window.location.pathname.split("/").filter(Boolean)[0],
    slug: window.location.pathname.split("/").filter(Boolean).pop(),
  });
</script>
