---
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import { getLocalizedCollection } from "@lib/content";
import { useTranslations, type Lang } from "@i18n/ui";

const { lang = "es" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const collection = await getLocalizedCollection("work", lang);
collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime());

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input;
  const month = input.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", { month: "short" });
  const year = new Date(input).getFullYear();
  return `${month} ${year}`;
}
---

<PageLayout title={t("work.title")} description={t("work.description")} lang={lang}>
  <TopLayout>
    <div class="animate page-heading">{t("work.title")}</div>
  </TopLayout>
  <BottomLayout>
    <ul>
      {
        work.map((entry) => (
          <li class="animate border-b border-term-border mt-6 py-12 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4 text-term-dim">
              {formatWorkDate(entry.data.dateStart)} - {formatWorkDate(entry.data.dateEnd)}
            </div>
            <div class="text-term-fg font-semibold">{entry.data.company}</div>
            <div class="text-sm font-semibold">{entry.data.role}</div>
            <article class="prose dark:prose-invert">
              <entry.Content />
            </article>
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>
