---
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Projects from "@components/Projects";
import { getLocalizedCollection, stripLocale } from "@lib/content";
import { useTranslations, type Lang } from "@i18n/ui";

const { lang = "es" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const projects = (await getLocalizedCollection("projects", lang))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((project) => ({
    collection: project.collection,
    slug: stripLocale(project.slug),
    data: project.data,
  }));

const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort((a, b) => a.localeCompare(b));
const categories = [...new Set(projects.map((project) => (project.data as any).category))].sort((a, b) => a.localeCompare(b));
---

<PageLayout title={t("projects.title")} description={t("projects.description")} lang={lang}>
  <TopLayout>
    <div class="animate page-heading">{t("projects.title")}</div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Projects client:load lang={lang} tags={tags} categories={categories} data={projects} />
    </div>
  </BottomLayout>
</PageLayout>
